{
  "name": "jev-calibrate",
  "version": "0.1.11",
  "description": "Calibrate Jev questions against your own labels: tune criteria on labelled examples, confirm on a held-out set, and learn whether each question works as a gate, a ranker, or not at all.",
  "license": "MIT",
  "author": "SMKRV",
  "homepage": "https://github.com/smkrv/jev-calibrate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smkrv/jev-calibrate.git"
  },
  "bugs": {
    "url": "https://github.com/smkrv/jev-calibrate/issues"
  },
  "type": "module",
  "bin": {
    "jev-calibrate": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-lines=97 --test-coverage-branches=84 --test-coverage-functions=93 \"test/**/*.test.ts\"",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "jev",
    "typesafe",
    "system-one",
    "evaluation",
    "calibration",
    "classification"
  ],
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2"
  }
}
